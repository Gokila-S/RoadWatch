# RoadWatch AI Service Configuration

# Set to true to disable the heavy CLIP model (Stage 2) in resource-constrained 
# environments (like Render free tier with 512MB RAM limit). This forces the service
# to run only the lightweight ONNX road damage detector (Stage 1).
# Default: false
DISABLE_CLIP=false

# Comma-separated list of allowed CORS origins. Use * to allow all (default)
# Example: http://localhost:5173,https://roadwatch.vercel.app
AI_ALLOWED_ORIGINS=*
